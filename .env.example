# UrjaSetu Environment Configuration
# Copy this file to .env and configure the values for your environment.

# ==========================================
# ENERGY PLANE (FastAPI Backend)
# ==========================================
DATABASE_URL=sqlite:///./urjasetu.db
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# ==========================================
# PAYMENT PLANE (x402 Node.js Gateway)
# ==========================================
PAYMENT_GATEWAY_PORT=4002

# The URL of the GoPlausible Facilitator
FACILITATOR_URL=https://api.goplausible.com

# Algorand Testnet Configuration
ALGOD_NETWORK=testnet
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=443
ALGOD_TOKEN=

# x402 Payment Requirements
X402_NETWORK=algorand:testnet
X402_SCHEME=x402
RECEIVER_ADDRESS=YOUR_ALGORAND_WALLET_ADDRESS_HERE
PAYMENT_ASSET_ID=0 # Use 0 for ALGO, or the specific ASA ID (e.g. USDC on testnet)
PAYMENT_AMOUNT=0.01 # 0.01 ALGO required per optimization

# ==========================================
# SECRETS (Never commit to version control)
# ==========================================
# Depending on the implementation, the Gateway might need to sign transactions
# or only the user wallet signs. If the Gateway needs to issue transactions,
# place secrets here and DO NOT commit.
# GATEWAY_PRIVATE_KEY=
